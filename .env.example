# Server Configuration
PORT=3000
APP_ENV=dev
BACKEND_URL=http://localhost:3000

# Database
DATABASE_URL="file:./dev.db"

# OpenAI API (for image generation, translations)
OPENAI_API_KEY=sk-proj-your-key-here

# Firebase Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id

# Bootstrap Secret (used for /api/bootstrap endpoints)
# Generate a strong random secret and set this in your .env
BOOTSTRAP_SECRET=your-secure-bootstrap-secret-here

# Optional: For development, you can also use Firebase Emulator
# FIREBASE_EMULATOR_HOST=localhost:9099
