#!/bin/bash
# Pre-commit hook to prevent committing sensitive files

set -e

# Patterns that should never be committed
FORBIDDEN_PATTERNS=(
    "\.env$"
    "\.env\."
    "firebase.*key\.json"
    "google.*\.json"
    "service.*account"
    "\.pem$"
    "\.key$"
    "credentials\.json"
    "BOOTSTRAP_SECRET"
    "FIREBASE_.*KEY"
    "GOOGLE_.*KEY"
    "AWS_SECRET"
)

echo "🔍 Running pre-commit security check..."

# Check staged files
STAGED_FILES=$(git diff --cached --name-only)

for file in $STAGED_FILES; do
    for pattern in "${FORBIDDEN_PATTERNS[@]}"; do
        if [[ "$file" =~ $pattern ]]; then
            echo "❌ BLOCKED: Attempting to commit sensitive file: $file"
            echo "   Pattern matched: $pattern"
            exit 1
        fi
    done
done

# Check file contents for suspicious patterns
for file in $STAGED_FILES; do
    if git show ":$file" 2>/dev/null | grep -iE "(firebase.*key|api.*key|secret|password)" > /dev/null 2>&1; then
        echo "⚠️  WARNING: File '$file' contains suspicious keywords (key, secret, password)"
        echo "   Please review before committing"
    fi
done

echo "✅ Pre-commit check passed"
exit 0
